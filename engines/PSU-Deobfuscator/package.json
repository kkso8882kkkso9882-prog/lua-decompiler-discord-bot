{
  "name": "psu-deobfuscator",
  "version": "1.1.0",
  "private": true,
  "description": "Static PSU Lua devirtualizer with Lua 5.1 bytecode recovery and readable source cleanup.",
  "type": "module",
  "bin": {
    "psu-deobf": "./src/cli.js"
  },
  "scripts": {
    "deobf": "node src/cli.js",
    "test": "node test/semanticRecovery.test.js && node test/sourceCleanup.test.js",
    "test:samples": "node src/testSamples.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "lua",
    "lua51",
    "deobfuscator",
    "devirtualizer",
    "psu"
  ],
  "dependencies": {
    "luaparse": "^0.3.1"
  }
}
